ADMIN_PASSWORD=your-secret-password
DATABASE_PATH=data/inventory.db
RESEND_API_KEY=your-resend-key
NICK_EMAIL=nick@doorflexaz.com
# Door order notifications (tech PWA "+ Door Order") go to NICK_EMAIL + MARIA_EMAIL.
# MARIA_EMAIL=maria@example.com
# Verified sender domain in Resend (your API key must be authorized for it)
REPORT_FROM=DoorFlex Inventory <reports@otomatelabs.com>
SECRET_KEY=change-this-to-a-random-secret
WEBHOOK_SECRET=generate-a-random-secret
# Backups: live next to the DB (inside the volume). Keep the last N snapshots.
# BACKUP_PATH=/app/data/backups
# BACKUP_RETENTION=15
# Monthly report: comma-separated recipients. Sent automatically on the 1st of each month at 00:05 AZ.
# REPORT_RECIPIENTS=you@example.com
# Weekly reorder/alert recipients (comma-separated). The Friday 08:00 AZ run
# sends the internal summary (orders sent + Amazon picks) and the weekly
# low-stock alert here. Empty by default (no alert emails until set).
# ALERT_RECIPIENTS=ops@example.com,maria@example.com
# Seconds between automated emails in the Friday run (deliverability throttle).
# EMAIL_SEND_DELAY=60
# Owner panel: secret path + required password. Both must be set or the whole
# panel is disabled (404). The path is the secret URL — make it unguessable.
# Generate one:  openssl rand -hex 6
# ADMIN_ACCESS_PASSWORD=your-owner-password
# ADMIN_PATH=/owner-<random-hash>
#
# PWA del técnico (Winston): no se configura con env vars. El token se genera
# y rota desde el panel Owner → PWA Tokens. El link de instalación es
# /tech/pwa/?t=<token>. Seed de demo: python -m modules.demo

# ─── Demo público ──────────────────────────────────────────────────────────
# DEMO_MODE=1 convierte este deploy en el demo público: regenera la base con
# datos sintéticos al arrancar y cada noche, simula los correos, apaga push,
# QuickBooks y el panel owner. NUNCA apuntarlo a la base de un cliente real.
# DEMO_MODE=1
# DEMO_PASSWORD=demo
# DEMO_PWA_TOKEN=demo-tech-andre
# DEMO_RESET_HOUR=3
# Visión con IA en el demo (opcional): sin key, la lectura de fotos queda
# desactivada con un mensaje claro. Con key, se limita a N llamadas por día.
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# DEMO_VISION_DAILY_LIMIT=40
